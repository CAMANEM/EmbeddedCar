#!/bin/bash

# GStreamer MJPEG Video Streaming Service for Embedded Car
# Optimized for Raspberry Pi 4 with Yocto/Poky

set -e

# Configuration - Can be overridden by environment variables
DEVICE="${VIDEO_DEVICE:-/dev/video0}"
WIDTH="${VIDEO_WIDTH:-640}"
HEIGHT="${VIDEO_HEIGHT:-480}"
FRAMERATE="${VIDEO_FRAMERATE:-30}"
PORT="${VIDEO_PORT:-8080}"
QUALITY="${VIDEO_QUALITY:-85}"
HOST="${VIDEO_HOST:-0.0.0.0}"

# Logging
LOG_FILE="/var/log/gstreamer-video.log"
PID_FILE="/var/run/gstreamer-video.pid"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_message() {
    echo -e "$(date '+%Y-%m-%d %H:%M:%S') $1" | tee -a "$LOG_FILE"
}

show_usage() {
    cat << EOF
🎥 GStreamer Video Streaming Service

Usage: $0 [start|stop|restart|status|config]

Commands:
  start     - Start video streaming service
  stop      - Stop video streaming service  
  restart   - Restart video streaming service
  status    - Show service status
  config    - Show current configuration

Environment Variables:
  VIDEO_DEVICE=$DEVICE       - Video device path
  VIDEO_WIDTH=$WIDTH         - Video width in pixels
  VIDEO_HEIGHT=$HEIGHT       - Video height in pixels
  VIDEO_FRAMERATE=$FRAMERATE - Frames per second
  VIDEO_PORT=$PORT           - TCP port for streaming
  VIDEO_QUALITY=$QUALITY     - JPEG quality (1-100)
  VIDEO_HOST=$HOST           - Host interface to bind

Examples:
  $0 start                              # Start with default settings
  VIDEO_PORT=8090 $0 start             # Start on different port
  VIDEO_WIDTH=1280 VIDEO_HEIGHT=720 $0 start  # HD resolution

Log file: $LOG_FILE
EOF
}

check_dependencies() {
    log_message "${BLUE}[INFO]${NC} Checking dependencies..."
    
    # Check GStreamer
    if ! command -v gst-launch-1.0 >/dev/null 2>&1; then
        log_message "${RED}[ERROR]${NC} gst-launch-1.0 not found. Install gstreamer1.0 package."
        return 1
    fi
    
    # Check video device
    if [ ! -e "$DEVICE" ]; then
        log_message "${YELLOW}[WARNING]${NC} Video device $DEVICE not found"
        log_message "${BLUE}[INFO]${NC} Available video devices:"
        ls -la /dev/video* 2>/dev/null || log_message "${YELLOW}[WARNING]${NC} No video devices found"
        log_message "${BLUE}[INFO]${NC} Try connecting a USB camera or check camera module connection"
        return 1
    fi
    
    # Check if device is accessible (basic check without v4l-utils)
    if [ ! -r "$DEVICE" ] || [ ! -w "$DEVICE" ]; then
        log_message "${YELLOW}[WARNING]${NC} Video device $DEVICE not accessible. Check permissions."
        log_message "${BLUE}[INFO]${NC} Try: chmod 666 $DEVICE"
        return 1
    fi
    
    # Test GStreamer pipeline (quick check)
    log_message "${BLUE}[INFO]${NC} Testing GStreamer pipeline..."
    timeout 2 gst-launch-1.0 v4l2src device="$DEVICE" ! fakesink >/dev/null 2>&1
    if [ $? -eq 0 ] || [ $? -eq 124 ]; then  # 124 = timeout (success)
        log_message "${GREEN}[SUCCESS]${NC} GStreamer pipeline test passed"
    else
        log_message "${YELLOW}[WARNING]${NC} GStreamer pipeline test failed, but will try anyway"
    fi
    
    log_message "${GREEN}[SUCCESS]${NC} Dependency check completed"
    return 0
}

show_config() {
    cat << EOF
🔧 Current Configuration:
  Device: $DEVICE
  Resolution: ${WIDTH}x${HEIGHT}
  Frame Rate: ${FRAMERATE} FPS
  Port: $PORT
  Quality: $QUALITY%
  Host: $HOST
  
📁 Files:
  Log: $LOG_FILE
  PID: $PID_FILE
EOF
}

get_service_status() {
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "running"
            return 0
        else
            rm -f "$PID_FILE"
            echo "stopped"
            return 1
        fi
    else
        echo "stopped"
        return 1
    fi
}

show_status() {
    local status=$(get_service_status)
    
    echo "🎥 GStreamer Video Streaming Service"
    echo "Status: $status"
    
    if [ "$status" = "running" ]; then
        local pid=$(cat "$PID_FILE")
        echo "PID: $pid"
        echo "Port: $PORT"
        echo "Uptime: $(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ' || echo 'unknown')"
        
        # Check if port is listening
        if netstat -tlnp 2>/dev/null | grep -q ":$PORT "; then
            echo "Network: ✅ Listening on port $PORT"
        else
            echo "Network: ❌ Port $PORT not listening"
        fi
    fi
    
    echo ""
    show_config
}

start_service() {
    local status=$(get_service_status)
    
    if [ "$status" = "running" ]; then
        log_message "${YELLOW}[WARNING]${NC} Service already running"
        return 0
    fi
    
    log_message "${BLUE}[INFO]${NC} Starting GStreamer Video Streaming Service..."
    
    # Check dependencies
    if ! check_dependencies; then
        log_message "${RED}[ERROR]${NC} Dependency check failed"
        return 1
    fi
    
    # Show configuration
    log_message "${BLUE}[CONFIG]${NC} $(echo; show_config)"
    
    # Create log directory
    mkdir -p "$(dirname "$LOG_FILE")"
    mkdir -p "$(dirname "$PID_FILE")"
    
    # Build GStreamer pipeline
    local pipeline="v4l2src device=$DEVICE ! \
video/x-raw,width=$WIDTH,height=$HEIGHT,framerate=$FRAMERATE/1 ! \
videoconvert ! \
jpegenc quality=$QUALITY ! \
multipartmux boundary=--videoboundary ! \
tcpserversink host=$HOST port=$PORT sync=false"
    
    log_message "${BLUE}[INFO]${NC} Starting GStreamer pipeline..."
    log_message "${BLUE}[PIPELINE]${NC} gst-launch-1.0 $pipeline"
    
    # Start GStreamer in background
    nohup gst-launch-1.0 $pipeline >> "$LOG_FILE" 2>&1 &
    local gst_pid=$!
    
    # Save PID
    echo "$gst_pid" > "$PID_FILE"
    
    # Wait a moment and check if process is still running
    sleep 2
    if kill -0 "$gst_pid" 2>/dev/null; then
        log_message "${GREEN}[SUCCESS]${NC} Service started successfully (PID: $gst_pid)"
        log_message "${GREEN}[INFO]${NC} Stream available at: tcp://$HOST:$PORT"
        return 0
    else
        log_message "${RED}[ERROR]${NC} Service failed to start"
        rm -f "$PID_FILE"
        return 1
    fi
}

stop_service() {
    local status=$(get_service_status)
    
    if [ "$status" = "stopped" ]; then
        log_message "${YELLOW}[WARNING]${NC} Service not running"
        return 0
    fi
    
    local pid=$(cat "$PID_FILE")
    log_message "${BLUE}[INFO]${NC} Stopping GStreamer Video Streaming Service (PID: $pid)..."
    
    # Graceful shutdown
    if kill -TERM "$pid" 2>/dev/null; then
        # Wait for graceful shutdown
        local count=0
        while kill -0 "$pid" 2>/dev/null && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
        done
        
        # Force kill if still running
        if kill -0 "$pid" 2>/dev/null; then
            log_message "${YELLOW}[WARNING]${NC} Graceful shutdown failed, forcing termination..."
            kill -KILL "$pid" 2>/dev/null || true
        fi
    fi
    
    rm -f "$PID_FILE"
    log_message "${GREEN}[SUCCESS]${NC} Service stopped"
}

restart_service() {
    log_message "${BLUE}[INFO]${NC} Restarting GStreamer Video Streaming Service..."
    stop_service
    sleep 2
    start_service
}

# Main script logic
case "${1:-}" in
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    restart)
        restart_service
        ;;
    status)
        show_status
        ;;
    config)
        show_config
        ;;
    *)
        show_usage
        exit 1
        ;;
esac

exit $?