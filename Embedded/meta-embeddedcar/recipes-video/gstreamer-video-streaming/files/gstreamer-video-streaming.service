[Unit]
Description=GStreamer Video Streaming Service for Embedded Car
Documentation=man:gst-launch-1.0(1)
After=network.target multi-user.target
Wants=network.target

[Service]
Type=forking
User=root
Group=video

# Environment
Environment=VIDEO_DEVICE=/dev/video0
Environment=VIDEO_WIDTH=640
Environment=VIDEO_HEIGHT=480
Environment=VIDEO_FRAMERATE=30
Environment=VIDEO_PORT=8080
Environment=VIDEO_QUALITY=85
Environment=VIDEO_HOST=0.0.0.0

# Configuration file
EnvironmentFile=-/etc/gstreamer-video.conf

# Service management
ExecStart=/usr/bin/gstreamer-video-streaming start
ExecStop=/usr/bin/gstreamer-video-streaming stop
ExecReload=/usr/bin/gstreamer-video-streaming restart

# Process management
PIDFile=/var/run/gstreamer-video.pid
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=30
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

# Security and resource limits
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log /var/run /tmp
DeviceAllow=/dev/video* rw
DevicePolicy=closed

# Logging
StandardOutput=append:/var/log/gstreamer-video.log
StandardError=append:/var/log/gstreamer-video.log
SyslogIdentifier=gstreamer-video

[Install]
WantedBy=multi-user.target